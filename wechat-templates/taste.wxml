<view class="page {{theme}}"><text class="eyebrow">DISCOVER YOUR COCKTAIL DNA</text><view class="title">你的口味，有迹可循。</view><view class="subtitle">选几种喜欢的味道，调出你的风味坐标。</view>
  <view wx:if="{{!editing && savedFlavors.length}}" class="saved-flavors"><view class="small muted">我的风味搭配</view><scroll-view scroll-x class="flavor-strip"><view wx:for="{{savedFlavors}}" wx:key="key" class="saved-flavor"><image src="{{item.image}}" mode="aspectFit" /><text>{{item.name}}</text></view></scroll-view></view>
  <button wx:if="{{!editing}}" class="secondary section" bindtap="edit">调整风味</button><view wx:if="{{editing}}" class="panel section"><view class="section-title">喜欢什么味道？</view><view class="palette"><view wx:for="{{palette}}" wx:key="key" class="flavor {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="toggle" role="checkbox" aria-checked="{{item.selected}}"><view class="flavor-icon"><image src="{{item.image}}" mode="aspectFit" /><text wx:if="{{item.selected}}" class="flavor-tick">✓</text></view><text>{{item.name}}</text><view class="flavor-note">{{item.note}}</view></view></view><view class="label">喜欢的酒感</view><view class="wrap"><text wx:for="{{strengths}}" wx:key="key" class="chip {{strength === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="strength">{{item.name}}</text></view><button class="secondary section" bindtap="cancel">取消</button><button class="section" disabled="{{!selected.length}}" bindtap="save">保存偏好，发现下一杯</button></view>
  <view wx:if="{{editing}}" class="panel"><view class="section-title">实时口味预览</view><view style="height:240rpx"><bar-art look="{{previewLook}}" /></view><view wx:for="{{previewBars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item.value}}%" /></view><text class="bar-value">{{item.value}}</text></view></view><view wx:if="{{dna.ready && !editing}}" class="panel"><view class="row"><view class="section-title">{{dna.stage}}</view><text class="badge">{{dna.count}} 款真实评价</text></view><view class="muted">{{dna.description}}</view><view class="section"><view wx:for="{{bars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item.value}}%" /></view><text class="bar-value">{{item.value}}</text></view></view><view class="info">{{dna.evidence}}</view><view class="section"><view>喜欢的基酒 · {{dna.base}}</view><view>喜欢的家族 · {{dna.family}}</view><view>偏好酒感 · {{preferredStrength}}</view><view>探索过的家族 · {{dna.explored}}</view></view></view>
  <view wx:if="{{!editing}}" wx:for="{{recommendations}}" wx:key="title" class="section"><view class="section-title">{{item.title}}</view><view class="muted" style="margin-bottom:20rpx">{{item.subtitle}}</view><view wx:for="{{item.items}}" wx:for-item="drink" wx:key="id" class="panel row" data-id="{{drink.id}}" bindtap="open"><image class="recommend-art" src="{{drink.image}}" mode="aspectFit" /><view class="grow"><view class="card-name">{{drink.name}}</view><view class="badge">匹配 {{drink.score}} · {{drink.base}}</view><view class="small muted">{{drink.reason}}</view></view><text>↗</text></view></view>
  <view wx:if="{{!editing}}" class="panel section"><view class="section-title">我的口味记录</view><view wx:if="{{!history.length}}" class="muted">暂无评价</view><view wx:for="{{history}}" wx:key="id" class="step-choice"><view>{{item.name}}</view><view class="small muted">{{item.ratingName}} · {{item.feedbackText}}</view><view class="actions"><button wx:if="{{item.available}}" class="link" data-id="{{item.id}}" bindtap="open">修改评价</button><button class="link" data-id="{{item.id}}" bindtap="remove">撤销评价</button></view></view><button wx:if="{{dna.ready}}" class="link danger section" bindtap="clear">清除口味档案</button></view>
  <view class="info">风味来自材料与用量的编辑估计，不是实测口感或酒精度。匹配分用于探索，不代表喜欢的概率；在配方页评价喝过的酒，可以逐渐完善 DNA。</view>
</view>
