<view class="page bottle-page {{theme}}">
  <text class="eyebrow">MAKE IT YOURS</text><view class="title">{{editing ? '编辑瓶子' : '登记材料'}}</view>
  <view class="bottle-preview"><bar-art mode="bottle" item="{{bottle}}" /></view>
  <view class="label">自定义名称</view><input value="{{name}}" bindinput="name" maxlength="100" />
  <view class="appearance-editor section">
    <view class="appearance-summary" data-panel="type" bindtap="togglePanel" role="button" aria-expanded="{{panel === 'type'}}"><view class="grow"><view>标准材料类型</view><view class="small muted">{{types[typeIndex]}}</view></view><text class="small muted">{{panel === 'type' ? '收起' : '点击选择'}}</text></view>
    <view wx:if="{{panel === 'type'}}" class="bottle-panel">
      <input value="{{query}}" bindinput="search" placeholder="搜索材料名称" aria-label="搜索材料名称" />
      <scroll-view scroll-x class="chips"><text class="chip {{category === 'all' ? 'selected' : ''}}" data-key="all" bindtap="category">全部</text><text wx:for="{{categories}}" wx:key="key" class="chip {{category === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="category">{{item.name}}</text></scroll-view>
      <scroll-view scroll-x class="shape-choices type-choices" scroll-into-view="type-{{typeIndex}}"><view wx:for="{{typeChoices}}" wx:key="key" id="type-{{item.index}}" class="shape-choice {{typeIndex === item.index ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="type" role="button" aria-label="{{item.name}}"><image class="type-art" src="{{item.image}}" mode="aspectFit" lazy-load /><view>{{item.name}}</view><text class="type-check">{{typeIndex === item.index ? '✓' : ''}}</text></view></scroll-view>
      <view wx:if="{{!typeChoices.length}}" class="small muted">未找到材料，试试更短的名称。</view><button class="link" data-index="0" bindtap="type">暂不选择类型</button>
    </view>
  </view>
  <view class="appearance-editor section">
    <view class="appearance-summary" data-panel="appearance" bindtap="togglePanel" role="button" aria-expanded="{{panel === 'appearance'}}"><view class="grow"><view>瓶型与颜色</view><view class="small muted">{{shapes[shapeIndex]}}</view></view><view class="appearance-swatch" style="background:{{color}}" /><text class="small muted">{{panel === 'appearance' ? '收起' : '点击修改'}}</text></view>
    <view wx:if="{{panel === 'appearance'}}" class="bottle-panel">
      <scroll-view scroll-x class="shape-choices" scroll-into-view="shape-{{shapeIndex}}"><view wx:for="{{shapeChoices}}" wx:key="key" id="shape-{{item.index}}" class="shape-choice {{shapeIndex === item.index ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="shape" role="button" aria-label="{{item.name}}"><view class="shape-art"><bar-art mode="bottle" item="{{item.bottle}}" /></view><text>{{item.name}}</text></view></scroll-view>
      <view class="label">颜色</view><view class="wrap"><view wx:for="{{colors}}" wx:key="*this" class="bottle-color {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="color" role="button" aria-label="{{item}}">{{color === item ? '✓' : ''}}</view></view><input class="section" value="{{color}}" bindchange="color" maxlength="7" placeholder="#79a883" aria-label="颜色" /><button class="secondary section" bindtap="closePanel">完成并收起</button>
    </view>
  </view>
  <view class="appearance-editor section">
    <view class="appearance-summary" data-panel="drawing" bindtap="togglePanel" role="button" aria-expanded="{{panel === 'drawing'}}"><view class="grow">标签手绘</view><text class="small muted">{{panel === 'drawing' ? '收起' : '点击修改'}}</text></view>
    <view wx:if="{{panel === 'drawing'}}" class="bottle-panel"><canvas type="2d" id="drawing" class="bottle-drawing" disable-scroll catchtouchstart="start" catchtouchmove="move" catchtouchend="end" catchtouchcancel="end" /><view class="actions"><button class="secondary" bindtap="undo">撤销一笔</button><button class="secondary" bindtap="clear">清空手绘</button></view><button class="secondary section" bindtap="closePanel">完成并收起</button></view>
  </view>
  <button class="section" bindtap="save">保存材料</button><button wx:if="{{editing}}" class="link danger section" bindtap="remove">删除</button>
</view>
