<view class="page {{theme}}"><text class="eyebrow">MAKE IT YOURS</text><view class="title">编辑瓶子</view><view style="height:340rpx;background:#d6dec4;border-radius:28rpx"><bar-art mode="bottle" item="{{bottle}}" /></view><view class="label">自定义名称</view><input value="{{name}}" bindinput="name" maxlength="100" /><view class="label">标准材料类型</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="type"><view class="picker">{{types[typeIndex]}} ▾</view></picker><view class="label">瓶型</view><picker range="{{shapes}}" value="{{shapeIndex}}" bindchange="shape"><view class="picker">{{shapes[shapeIndex]}} ▾</view></picker><view class="label">颜色</view><view class="wrap"><view wx:for="{{colors}}" wx:key="*this" style="background:{{item}};width:54rpx;height:54rpx;border-radius:50%;border:2rpx solid #eee" data-color="{{item}}" bindtap="color" /></view><input class="section" value="{{color}}" bindchange="color" maxlength="7" placeholder="#79a883" /><view class="label">标签手绘</view><canvas type="2d" id="drawing" style="width:100%;height:600rpx;background:#fff8e8;border-radius:20rpx" disable-scroll catchtouchstart="start" catchtouchmove="move" catchtouchend="end" catchtouchcancel="end" /><view class="actions"><button class="secondary" bindtap="undo">撤销一笔</button><button class="secondary" bindtap="clear">清空手绘</button></view><button class="section" bindtap="save">保存材料</button><button wx:if="{{editing}}" class="link danger section" bindtap="remove">删除</button></view>
