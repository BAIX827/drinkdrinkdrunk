<view class="page {{theme}}"><text class="eyebrow">LITTLE MOMENTS, GOOD SIPS</text><view class="title">饮酒日记</view><view class="subtitle">记下味道，也记下当时的心情。</view>
  <view class="panel section"><view class="calendar-heading"><button class="link month-arrow" disabled="{{!previous}}" data-direction="previous" bindtap="month" aria-label="上个月">‹</button><view class="calendar-month">{{month}}</view><button class="link month-arrow" disabled="{{!next}}" data-direction="next" bindtap="month" aria-label="下个月">›</button></view><view id="tour-calendar" class="calendar"><text wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</text><view wx:for="{{cells}}" wx:key="key" class="day {{item.selected ? 'selected' : ''}} {{item.today ? 'today' : ''}}" data-date="{{item.date}}" bindtap="day"><text>{{item.day}}</text><view wx:if="{{item.count}}" class="dot">{{item.count > 1 ? item.count : '•'}}</view></view></view><view class="row section"><text class="small muted">本月留下 {{count}} 杯回忆</text><button class="link" bindtap="today">回到今天</button></view></view>
  <view class="row section journal-date-row"><view class="section-title">{{selected}}</view><button class="link" bindtap="add">＋ 记一杯</button></view>
  <view wx:for="{{logs}}" wx:key="id" class="panel row" data-id="{{item.id}}" bindtap="edit"><view class="journal-art"><bar-art recipe="{{item.recipe}}" look="{{item.look}}" /></view><view class="grow"><view class="card-name">{{item.name}}</view><view class="log-note muted">{{item.note || '这一杯，还没有留下感想。'}}</view><view wx:if="{{item.photoCount}}" class="badge">{{item.photoCount}} 张照片</view><button wx:if="{{item.recipeID}}" class="link" data-recipe="{{item.recipeID}}" catchtap="rate">打开关联配方评价</button></view><text>↗</text></view>
  <view wx:if="{{!logs.length}}" class="empty"><view>这一天，还是一张空白酒单。</view><button class="secondary section" bindtap="add">记下这一杯</button></view>
<bar-tour page="journal" /></view>
