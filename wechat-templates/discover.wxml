<view class="page {{theme}}"><view wx:if="{{opening && !reduced}}" class="opening"><text>AFTER HOURS</text></view>
  <view class="row"><text class="eyebrow">DRINK DRINK DRUNK</text><button class="link" bindtap="settings">设置 ↗</button></view>
  <bar-music locale="{{locale}}" /><view class="title">今晚，调点喜欢的。</view>
  <view class="subtitle">{{total}} 款配方 · 你的私人小吧台</view>
  <view class="hero section" bindtap="taste"><text class="eyebrow">DISCOVER YOUR COCKTAIL DNA</text><view class="section-title" style="margin-top:12rpx">{{ready ? '让下一杯，更懂你的口味。' : '从一片柠檬，认识你的口味。'}}</view><view class="row"><text class="muted">选择风味，找到属于你的那一杯</text><text>↗</text></view></view>
  <input placeholder="搜索酒名、基酒或材料" value="{{query}}" bindinput="search" confirm-type="search" aria-label="搜索配方" />
  <scroll-view scroll-x class="chips"><text class="chip {{scope === 'all' ? 'selected' : ''}}" data-value="all" bindtap="scope">全部配方</text><text class="chip {{scope === 'favorites' ? 'selected' : ''}}" data-value="favorites" bindtap="scope">我的收藏</text><text class="chip {{scope === 'curated' ? 'selected' : ''}}" data-value="curated" bindtap="scope">精选配方</text><text class="chip {{scope === 'guided' ? 'selected' : ''}}" data-value="guided" bindtap="scope">动画跟做</text><text class="chip {{scope === 'mine' ? 'selected' : ''}}" data-value="mine" bindtap="scope">我的配方</text></scroll-view>
  <scroll-view id="tour-stock" scroll-x class="chips"><text class="chip {{stock === 'all' ? 'selected' : ''}}" data-value="all" bindtap="stock">不限材料</text><text class="chip {{stock === '0' ? 'selected' : ''}}" data-value="0" bindtap="stock">现在能调</text><text class="chip {{stock === '1' ? 'selected' : ''}}" data-value="1" bindtap="stock">最多缺 1 样</text><text class="chip {{stock === '2' ? 'selected' : ''}}" data-value="2" bindtap="stock">最多缺 2 样</text></scroll-view>
  <view class="label">检查哪些材料</view><view class="wrap"><text wx:for="{{categories}}" wx:key="key" class="chip {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="category">{{item.name}}</text></view><view class="small muted" style="margin:14rpx 0">未检查的类别不代表已有材料。</view><view class="row" style="margin-bottom:24rpx"><picker range="{{bases}}" bindchange="base"><view class="chip">{{base}} ▾</view></picker><button wx:if="{{ready}}" class="link" bindtap="sort">{{sort === 'match' ? '按口味匹配 ↓' : '默认顺序 ↓'}}</button><text class="muted small">{{cards.length}} 款</text></view>
  <view wx:if="{{stock !== 'all' && !inventoryCount}}" class="info">先在「我的酒」勾选已有材料，就能知道现在可以调什么。</view>
  <view wx:if="{{ready}}" class="section"><view wx:for="{{recommendations}}" wx:key="title" class="panel"><view class="section-title">{{item.title}}</view><view wx:if="{{!item.items.length}}" class="small muted">当前筛选下暂无推荐</view><view wx:for="{{item.items}}" wx:for-item="drink" wx:key="id" class="step-choice" data-id="{{drink.id}}" bindtap="open"><view>{{drink.name}} · {{drink.score}}%</view><view class="small muted">{{drink.reason}}</view><view class="small stock">{{!drink.checked ? '尚未检查材料' : drink.missing ? '还缺 ' + drink.missing + ' 样材料' : '材料齐了 · 可以开调'}}</view></view></view></view><button class="link" bindtap="reset">重置筛选</button>
  <view class="grid"><view wx:for="{{cards}}" wx:key="id" class="drink-card" data-id="{{item.id}}" bindtap="open"><view class="drink-art"><bar-art wx:if="{{item.custom}}" recipe="{{item.recipe}}" /><image wx:else src="{{item.image}}" mode="aspectFit" lazy-load /><button class="heart" data-id="{{item.id}}" catchtap="favorite" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}">{{item.favorite ? '♥' : '♡'}}</button></view><view class="card-body"><view class="card-name">{{item.name}}</view><view class="card-en">{{item.english}}</view><view class="badge">{{item.base}}<text wx:if="{{item.score !== null}}"> · 匹配 {{item.score}}</text></view><view class="small muted">{{item.flavor}}</view><view wx:for="{{item.bars}}" wx:for-item="drink" wx:key="name" class="bar-row"><text class="bar-label">{{drink.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{drink.value}}%" /></view></view><view class="stock {{item.missing ? 'missing' : ''}}">{{!item.checked ? '尚未检查材料' : item.missing ? '还缺 ' + item.missing + ' 样材料' : '材料齐了 · 可以开调'}}</view></view></view></view>
  <view wx:if="{{!cards.length}}" class="empty">没有找到配方，试试其他关键词或筛选条件。</view>
  <button id="tour-add-recipe" class="secondary section" bindtap="create">＋ 记下自己的配方</button>
  <view class="footer-note">一杯的灵感，从这里开始。</view>
<bar-tour page="discover" /></view>
