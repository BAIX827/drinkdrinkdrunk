<view class="page {{theme}}"><block wx:if="{{recipe}}"><text class="eyebrow">ONE STEP AT A TIME</text><view class="title">{{recipe.chineseName}}</view><bar-music locale="{{locale}}" /><view class="guide-stage"><bar-art mode="stage" recipe="{{recipe}}" scene="{{scene}}" playing="{{playing}}" reduced="{{reduced}}" /></view><view class="label">最终杯型</view><picker range="{{glasses}}" value="{{glassIndex}}" bindchange="glass"><view class="picker">{{glasses[glassIndex]}} ▾</view></picker><view class="wrap section"><text class="chip {{lookMode === 'recipe' ? 'selected' : ''}}" data-mode="recipe" bindtap="look">配方外观</text><text class="chip {{lookMode === 'plain' ? 'selected' : ''}}" data-mode="plain" bindtap="look">纯色</text></view><view class="label">酒液颜色</view><input value="{{color}}" maxlength="7" bindchange="color" placeholder="#da9561" /><view class="row section"><text>语音提示</text><switch checked="{{speech}}" bindchange="voice" color="#92b58b" /></view>
  <view class="panel section"><view class="row"><text class="eyebrow">STEP {{index + 1}} / {{total}}</text><text wx:if="{{!complete}}" class="stat">{{remaining}}<text class="small"> 秒</text></text><text wx:else class="stat">✓</text></view><progress percent="{{progress}}" activeColor="#d9be88" backgroundColor="#526a50" stroke-width="3" /><view class="section-title section">{{complete ? '为这一杯留个纪念。' : label}}</view><view wx:if="{{!complete}}"><view class="amount">{{step.ingredient ? step.ingredient.raw : step.tool}}</view><view class="section">{{step.hint}}</view><view class="muted small section">器具：{{step.tool}}</view><view class="info">接下来 · {{nextLabel}}</view></view><view wx:else class="muted">完成后可一键记入今天的日记，再去补上照片和感想。</view>
    <view class="actions"><button class="secondary" disabled="{{index === 0}}" bindtap="previous">上一步</button><button bindtap="toggle">{{complete ? '再调一杯' : playing ? '暂停' : '继续'}}</button><button class="secondary" disabled="{{complete}}" bindtap="next">{{index === total - 1 ? '完成' : '下一步'}}</button></view>
    <button wx:if="{{complete}}" class="section" disabled="{{recorded}}" bindtap="record">{{recorded ? '已加入饮酒日记' : '一键加入饮酒日记'}}</button>
  </view>
  <view class="row"><picker range="{{delays}}" bindchange="delay" disabled="{{complete}}"><view class="chip">每步等待 {{delay}} 秒 ▾</view></picker><button class="link" bindtap="awake">{{awake ? '关闭常亮' : '保持屏幕常亮'}}</button></view><view class="info">点「继续」自动播放；随时可以手动切换步骤。摇匀、搅拌按配方时长与等待时间的较大值计时。切到后台自动暂停，返回后手动继续。</view>
</block><view wx:else class="empty">没有找到配方，请返回重试。</view></view>
