<view class="page guide-page {{theme}}">
  <block wx:if="{{recipe}}">
    <view class="guide-heading"><text class="eyebrow">{{complete ? '调制完成' : '分步跟做'}}</text><view class="title">{{recipe.chineseName}}</view></view>
    <view class="guide-progress"><text>{{complete ? '已完成' : '步骤 ' + (index + 1) + ' / ' + total}}</text><text class="guide-status">{{complete ? '这一杯，完成了。' : playing ? '自动跟做中' : started ? '已暂停，可手动切换' : '准备好后开始'}}</text></view>
    <progress percent="{{progress}}" activeColor="#d9be88" backgroundColor="#526a50" stroke-width="3" />
    <view class="guide-stage"><bar-art mode="stage" recipe="{{recipe}}" scene="{{scene}}" playing="{{playing}}" reduced="{{reduced}}" /></view>
    <view class="panel guide-current">
      <view class="row"><view class="section-title">{{complete ? '为这一杯留个纪念。' : label}}</view><view wx:if="{{!complete}}" class="guide-timer"><text>{{remaining}}</text><text class="small"> 秒</text></view><text wx:else class="guide-done">✓</text></view>
      <block wx:if="{{!complete}}"><view wx:if="{{step.ingredient}}" class="amount">{{step.ingredient.raw}}</view><view class="guide-hint">{{step.hint}}</view><view class="small muted guide-tool">器具：{{step.tool}}</view></block>
      <view wx:else class="muted">{{recorded ? '已加入饮酒日记' : '完成后可一键记入今天的日记，再去补上照片和感想。'}}</view>
    </view>
    <view wx:if="{{!complete}}" class="guide-next small muted">接下来 · {{nextLabel}}</view>
    <view class="guide-options">
      <button class="guide-disclosure" data-panel="settings" bindtap="togglePanel" aria-expanded="{{panel === 'settings'}}"><text>跟做设置</text><text>{{panel === 'settings' ? '−' : '＋'}}</text></button>
      <view wx:if="{{panel === 'settings'}}" class="guide-option-body">
        <view class="row setting-row"><text>每步等待</text><picker range="{{delays}}" value="{{delayIndex}}" bindchange="delay" disabled="{{complete}}"><view class="chip">{{delay}} 秒 ▾</view></picker></view>
        <view class="row setting-row"><text>语音提示</text><switch checked="{{speech}}" bindchange="voice" color="#92b58b" /></view>
        <view class="row setting-row"><text>保持屏幕常亮</text><switch checked="{{awake}}" bindchange="awake" color="#92b58b" /></view>
        <bar-music locale="{{locale}}" />
        <view class="small muted">切到后台会暂停，返回后点继续。摇匀与搅拌会保留配方要求的时长。</view>
      </view>
      <button class="guide-disclosure" data-panel="appearance" bindtap="togglePanel" aria-expanded="{{panel === 'appearance'}}"><view class="grow"><view>酒杯与外观</view><view class="small muted">{{glasses[glassIndex]}}</view></view><view class="appearance-swatch" style="background:{{color}}" /><text>{{panel === 'appearance' ? '−' : '＋'}}</text></button>
      <view wx:if="{{panel === 'appearance'}}" class="guide-option-body">
        <view class="small muted">最终杯型</view>
        <scroll-view scroll-x class="shape-choices"><view wx:for="{{glassChoices}}" wx:key="key" class="shape-choice {{glassIndex === item.index ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="glass" role="button" aria-label="{{item.name}}"><view class="shape-art"><bar-art look="{{item.look}}" /></view><text>{{item.name}}</text></view></scroll-view>
        <view class="wrap"><text class="chip {{lookMode === 'recipe' ? 'selected' : ''}}" data-mode="recipe" bindtap="look">配方外观</text><text class="chip {{lookMode === 'plain' ? 'selected' : ''}}" data-mode="plain" bindtap="look">纯色</text></view>
        <view class="label">酒液颜色</view><view class="wrap color-options"><button wx:for="{{colors}}" wx:key="*this" class="color-choice {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="color" aria-label="{{item}}">{{color === item ? '✓' : ''}}</button></view><input value="{{color}}" maxlength="7" bindchange="color" placeholder="#da9561" aria-label="酒液颜色" /><button class="secondary section" bindtap="closeAppearance">完成并收起</button>
      </view>
      <button class="guide-disclosure" data-panel="steps" bindtap="togglePanel" aria-expanded="{{panel === 'steps'}}"><text>全部步骤 · {{total}}</text><text>{{panel === 'steps' ? '−' : '＋'}}</text></button>
      <view wx:if="{{panel === 'steps'}}" class="guide-option-body"><view class="small muted">点选步骤后暂停，确认准备好再继续。</view><view wx:for="{{stepList}}" wx:for-index="stepNumber" wx:key="index" class="step-choice {{index === item.index ? 'active' : ''}}" data-index="{{item.index}}" bindtap="jump" role="button"><view>{{item.index + 1}} · {{item.label}}</view><view class="small muted">{{item.hint}}</view></view></view>
    </view>
    <view class="guide-dock">
      <view wx:if="{{!complete}}" class="guide-controls"><button class="secondary" disabled="{{index === 0}}" bindtap="previous">上一步</button><button class="guide-play" bindtap="toggle">{{playing ? '暂停' : started ? '继续' : '开始跟做'}}</button><button class="secondary" bindtap="next">{{index === total - 1 ? '完成' : '下一步'}}</button></view>
      <view wx:else class="guide-finish-controls"><button class="secondary" bindtap="toggle">再调一杯</button><button wx:if="{{recorded}}" bindtap="journal">查看日记 / 补充照片</button><button wx:else bindtap="record">一键加入饮酒日记</button></view>
    </view>
  </block>
  <view wx:else class="empty">没有找到配方，请返回重试。</view>
</view>
