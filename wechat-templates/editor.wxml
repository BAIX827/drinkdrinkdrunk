<view class="page {{theme}}"><canvas type="2d" id="photo-canvas" style="position:fixed;left:-3000px;top:0;width:300px;height:300px;pointer-events:none" /><text class="eyebrow">{{type === 'recipe' ? 'YOUR OWN CREATION' : 'SAVE THIS MOMENT'}}</text><view class="title">{{type === 'recipe' ? '把灵感，写成配方。' : '这一杯，什么滋味？'}}</view>
  <block wx:if="{{type === 'log'}}"><view class="label">日期</view><picker mode="date" value="{{date}}" bindchange="date"><view class="picker">{{date}} ▾</view></picker><view class="label">从配方选择（可选）</view><picker range="{{recipeNames}}" value="{{recipeIndex}}" bindchange="selectRecipe"><view class="picker">{{recipeNames[recipeIndex]}} ▾</view></picker></block>
  <view class="label">{{type === 'recipe' ? '配方名称' : '这一杯的名字'}}</view><input value="{{name}}" data-field="name" bindinput="input" maxlength="100" placeholder="例如：周五的莫吉托" />
  <block wx:if="{{type === 'recipe'}}"><view class="label">英文名称（可选）</view><input value="{{english}}" data-field="english" bindinput="input" maxlength="100" placeholder="Friday Mojito" /><view class="label">材料与用量 · 每行一种</view><textarea value="{{ingredients}}" data-field="ingredients" bindinput="input" maxlength="5000" placeholder="白朗姆 45 ml&#10;青柠汁 20 ml&#10;糖浆 15 ml" /><view class="label">杯型</view><picker range="{{glassNames}}" value="{{glassIndex}}" bindchange="glass"><view class="picker">{{glassNames[glassIndex]}} ▾</view></picker><view class="label">酒液颜色</view><input value="{{color}}" maxlength="7" bindchange="color" /><view class="label">调制方法</view><textarea value="{{method}}" data-field="method" bindinput="input" maxlength="5000" placeholder="写下完整做法。自建配方将按备料和原方提示跟做。" /></block>
  <view class="label">{{type === 'recipe' ? '配方备注（可选）' : '味道、心情，或一起喝的人（可选）'}}</view><textarea value="{{note}}" data-field="note" bindinput="input" maxlength="5000" placeholder="留一点文字给以后的自己。" />
  <block wx:if="{{type === 'log'}}"><view class="label">照片 · 最多 3 张</view><view class="photo-row"><view wx:for="{{photos}}" wx:key="index"><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto" /><button class="photo-remove" data-index="{{index}}" bindtap="removePhoto">移除</button></view></view><button wx:if="{{photos.length < 3}}" class="secondary section" loading="{{busy}}" disabled="{{busy}}" bindtap="addPhotos">＋ 添加照片</button><view class="small muted section">照片压缩后保存在本机，并随 JSON 备份导出。请另行保留原图。</view></block>
  <button class="section" disabled="{{busy}}" bindtap="save">保存{{type === 'recipe' ? '配方' : '日记'}}</button><button wx:if="{{editing}}" class="link danger section" bindtap="remove">删除这{{type === 'recipe' ? '款配方' : '篇日记'}}</button>
</view>
