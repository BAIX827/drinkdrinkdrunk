<view class="page {{theme}}"><block wx:if="{{recipe}}"><view class="recipe-hero"><bar-art wx:if="{{recipe.isUserCreated}}" recipe="{{recipe}}" /><image wx:else src="{{image}}" mode="aspectFit" /><text class="recipe-mark">THE NEXT SIP</text></view><view class="row section"><view class="grow"><text class="eyebrow">{{recipe.englishName}}</text><view class="title">{{recipe.chineseName}}</view></view><button class="secondary" bindtap="favorite">{{favorite ? '♥ 已收藏' : '♡ 收藏'}}</button></view><view class="wrap"><text class="chip">{{recipe.glass}}</text><text class="chip">{{profile.family}}</text><text wx:if="{{score !== null}}" class="chip">口味匹配 {{score}}</text></view>
  <view class="actions"><button bindtap="guide">开始跟做 →</button><button class="secondary" bindtap="log">记下这一杯</button></view>
  <view id="tour-ingredients" class="panel section"><view class="section-title">准备材料</view><view wx:for="{{ingredients}}" wx:key="index" class="ingredient row"><text class="grow">{{item.raw}}</text><text class="small {{item.available ? 'stock' : 'missing'}}">{{item.optional ? '可选' : item.available ? '✓ 已有' : '需准备'}}</text></view><view class="small muted section">材料按「我的酒」匹配；另备做法中需要的冰块与装饰。</view></view>
  <view class="panel"><view class="section-title">调制方法</view><view>{{recipe.method}}</view><view wx:if="{{recipe.note}}" class="info">{{recipe.note}}</view><button wx:if="{{recipe.source.url}}" class="link" bindtap="source">复制原配方来源 ↗</button></view>
  <view class="panel"><view class="section-title">这一杯的风味</view><view wx:if="{{profile.unknown.length}}" class="info">部分材料尚无风味数据，不显示估计分数。</view><block wx:else><view wx:for="{{bars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item.value}}%" /></view><text class="bar-value">{{item.value}}</text></view><view class="muted section">{{explanation}}</view><view class="small muted">编辑估计，非实测口感或酒精度。</view></block>
    <view wx:if="{{dna.ready && !profile.unknown.length}}" class="section"><view class="section-title">个人口味与本杯对比</view><view class="small muted">本杯 / 你的偏好</view><view wx:for="{{personalBars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="grow"><view class="bar-track"><view class="bar-fill" style="width:{{item.first}}%" /></view><view class="bar-track" style="margin-top:8rpx"><view class="bar-fill" style="width:{{item.second}}%;background:#92b58b" /></view></view><text class="small">{{item.first}} / {{item.second}}</text></view></view><picker range="{{compareOptions}}" bindchange="compare"><view class="picker section">选择另一杯，比较风味 ▾</view></picker><view wx:if="{{compare}}" class="section"><view class="small muted">金色：本杯 · 绿色：{{compare.name}}</view><view wx:if="{{compare.unknown || profile.unknown.length}}" class="info">包含未知材料，暂不比较。</view><block wx:else><view wx:for="{{compare.bars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="grow"><view class="bar-track"><view class="bar-fill" style="width:{{item.first}}%" /></view><view class="bar-track" style="margin-top:8rpx"><view class="bar-fill" style="width:{{item.second}}%;background:#92b58b" /></view></view><text class="small">{{item.first}} / {{item.second}}</text></view></block></view>
  </view>
  <view class="panel"><view class="section-title">喝过之后，感觉如何？</view><view class="wrap"><text wx:for="{{ratings}}" wx:key="key" class="chip {{rating === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="rate">{{item.name}}</text></view><view wx:if="{{rating}}" class="section"><view class="small muted" style="margin-bottom:16rpx">再具体一点（可选）</view><view class="wrap"><text wx:for="{{feedbackOptions}}" wx:key="key" class="chip {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="feedback">{{item.name}}</text></view><view wx:if="{{ratingDirty}}" class="actions"><button class="secondary" bindtap="cancelRating">取消</button><button bindtap="saveRating">保存口味评价</button></view><button wx:if="{{savedRating}}" class="link" bindtap="removeRating">撤销评价</button></view></view>
  <button id="tour-share" class="section" bindtap="shareCard">图片分享卡片</button><view class="spacer" /><button wx:if="{{!recipe.isUserCreated}}" open-type="share" class="secondary">分享这款配方给朋友</button><button wx:else class="secondary" bindtap="edit">编辑我的配方</button>
</block><view wx:else class="empty">没有找到这款配方，请返回发现页。</view><bar-tour page="recipe" /></view>
