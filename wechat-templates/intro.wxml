<view class="page intro-page {{theme}}"><view class="row"><text class="eyebrow">WELCOME TO YOUR HOME BAR</text><button class="link" disabled="{{finishing}}" bindtap="finish">跳过引导</button></view><view class="hero section intro-card"><view class="intro-art"><bar-art /></view><view class="badge">{{destination}} · {{index+1}} / {{total}}</view><view class="title">{{title}}</view><view>{{description}}</view><progress class="section" percent="{{(index+1)/total*100}}" activeColor="#d9be88" stroke-width="3" /><view class="actions"><button disabled="{{!index || finishing}}" class="secondary" bindtap="previous">上一项</button><button disabled="{{finishing}}" bindtap="next">{{index === total-1 ? '开始体验' : '下一项'}}</button></view></view></view>
