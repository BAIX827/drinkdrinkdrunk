<view class="music"><button bindtap="toggle">{{pending ? (locale === 'en' ? 'Loading…' : '加载中…') : playing ? (locale === 'en' ? 'Ⅱ Pause music' : 'Ⅱ 暂停音乐') : (locale === 'en' ? '♫ Bar music' : '♫ 吧台音乐')}}</button><slider value="{{volume}}" min="0" max="100" bindchange="volume" activeColor="#d9be88" block-size="16" aria-label="{{locale === 'en' ? 'Music volume' : '音乐音量'}}" /></view>
