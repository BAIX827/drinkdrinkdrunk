<view class="page {{theme}}"><block wx:if="{{recipe}}"><text class="eyebrow">ONE STEP AT A TIME</text><view class="title">{{v.recipe.chineseName}}</view><bar-music locale="{{locale}}" /><view class="guide-stage"><bar-art mode="stage" recipe="{{recipe}}" scene="{{scene}}" playing="{{playing}}" reduced="{{reduced}}" /></view><view class="label">{{(locale === 'en' ? 'Final glass' : '最终杯型')}}</view><picker range="{{v.glasses}}" value="{{glassIndex}}" bindchange="glass"><view class="picker">{{v.glasses[v.glassIndex]}} ▾</view></picker><view class="wrap section"><text class="chip {{lookMode === 'recipe' ? 'selected' : ''}}" data-mode="recipe" bindtap="look">{{(locale === 'en' ? 'Recipe appearance' : '配方外观')}}</text><text class="chip {{lookMode === 'plain' ? 'selected' : ''}}" data-mode="plain" bindtap="look">{{(locale === 'en' ? 'Plain color' : '纯色')}}</text></view><view class="label">{{(locale === 'en' ? 'Drink color' : '酒液颜色')}}</view><input value="{{color}}" maxlength="7" bindchange="color" placeholder="#da9561" /><view class="row section"><text>{{(locale === 'en' ? 'Voice guidance' : '语音提示')}}</text><switch checked="{{speech}}" bindchange="voice" color="#92b58b" /></view>
  <view class="panel section"><view class="row"><text class="eyebrow">STEP {{index + 1}} / {{v.total}}</text><text wx:if="{{!complete}}" class="stat">{{v.remaining}}<text class="small">{{(locale === 'en' ? ' s' : ' 秒')}}</text></text><text wx:else class="stat">✓</text></view><progress percent="{{progress}}" activeColor="#d9be88" backgroundColor="#526a50" stroke-width="3" /><view class="section-title section">{{v.complete ? (locale === 'en' ? 'Keep a memory of this drink.' : '为这一杯留个纪念。') : v.label}}</view><view wx:if="{{!complete}}"><view class="amount">{{v.step.ingredient ? v.step.ingredient.raw : v.step.tool}}</view><view class="section">{{v.step.hint}}</view><view class="muted small section">{{(locale === 'en' ? 'Tool: ' : '器具：')}}{{v.step.tool}}</view><view class="info">{{(locale === 'en' ? 'Next · ' : '接下来 · ')}}{{v.nextLabel}}</view></view><view wx:else class="muted">{{(locale === 'en' ? 'Log it in today’s diary, then add photos and thoughts.' : '完成后可一键记入今天的日记，再去补上照片和感想。')}}</view>
    <view class="actions"><button class="secondary" disabled="{{index === 0}}" bindtap="previous">{{(locale === 'en' ? 'Back' : '上一步')}}</button><button bindtap="toggle">{{v.complete ? (locale === 'en' ? 'Mix another' : '再调一杯') : v.playing ? (locale === 'en' ? 'Pause' : '暂停') : (locale === 'en' ? 'Continue' : '继续')}}</button><button class="secondary" disabled="{{complete}}" bindtap="next">{{index === v.total - 1 ? (locale === 'en' ? 'Finish' : '完成') : (locale === 'en' ? 'Next' : '下一步')}}</button></view>
    <button wx:if="{{complete}}" class="section" disabled="{{recorded}}" bindtap="record">{{v.recorded ? (locale === 'en' ? 'Added to journal' : '已加入饮酒日记') : (locale === 'en' ? 'Add to journal' : '一键加入饮酒日记')}}</button>
  </view>
  <view class="row"><picker range="{{v.delays}}" bindchange="delay" disabled="{{complete}}"><view class="chip">{{(locale === 'en' ? 'Step interval ' : '每步等待 ')}}{{v.delay}}{{(locale === 'en' ? ' s ▾' : ' 秒 ▾')}}</view></picker><button class="link" bindtap="awake">{{v.awake ? (locale === 'en' ? 'Disable keep awake' : '关闭常亮') : (locale === 'en' ? 'Keep screen awake' : '保持屏幕常亮')}}</button></view><view class="info">{{(locale === 'en' ? 'Tap Continue for automatic steps, or navigate manually. Shaking and stirring use the longer of the recipe duration and the step delay. Going to the background pauses playback; resume manually.' : '点「继续」自动播放；随时可以手动切换步骤。摇匀、搅拌按配方时长与等待时间的较大值计时。切到后台自动暂停，返回后手动继续。')}}</view>
</block><view wx:else class="empty">{{(locale === 'en' ? 'Recipe not found. Go back and try again.' : '没有找到配方，请返回重试。')}}</view></view>
