<view class="page guide-page {{theme}}">
  <block wx:if="{{recipe}}">
    <view class="guide-heading"><text class="eyebrow">{{v.complete ? (locale === 'en' ? 'Mixing complete' : '调制完成') : (locale === 'en' ? 'Guided mixing' : '分步跟做')}}</text><view class="title">{{v.recipe.chineseName}}</view></view>
    <view class="guide-progress"><text>{{v.complete ? (locale === 'en' ? 'Complete' : '已完成') : (locale === 'en' ? 'Step ' : '步骤 ') + (index + 1) + ' / ' + v.total}}</text><text class="guide-status">{{v.complete ? (locale === 'en' ? 'Your drink is ready.' : '这一杯，完成了。') : v.playing ? (locale === 'en' ? 'Auto-play' : '自动跟做中') : v.started ? (locale === 'en' ? 'Paused · manual steps available' : '已暂停，可手动切换') : (locale === 'en' ? 'Start when ready' : '准备好后开始')}}</text></view>
    <progress percent="{{progress}}" activeColor="#d9be88" backgroundColor="#526a50" stroke-width="3" />
    <view class="guide-stage"><bar-art mode="stage" recipe="{{recipe}}" scene="{{scene}}" playing="{{playing}}" reduced="{{reduced}}" /></view>
    <view class="panel guide-current">
      <view class="row"><view class="section-title">{{v.complete ? (locale === 'en' ? 'Keep a memory of this drink.' : '为这一杯留个纪念。') : v.label}}</view><button wx:if="{{!complete}}" class="voice-chip {{speech ? 'on' : ''}}" bindtap="voice" aria-pressed="{{speech}}">{{v.speech ? (locale === 'en' ? '🔊 Voice on' : '🔊 语音开') : (locale === 'en' ? '🔈 Voice off' : '🔈 语音关')}}</button><view wx:if="{{!complete}}" class="guide-timer"><text>{{v.remaining}}</text><text class="small">{{(locale === 'en' ? ' s' : ' 秒')}}</text></view><text wx:else class="guide-done">✓</text></view>
      <block wx:if="{{!complete}}"><view wx:if="{{step.ingredient}}" class="amount">{{v.step.ingredient.raw}}</view><view class="guide-hint">{{v.step.hint}}</view><view class="small muted guide-tool">{{(locale === 'en' ? 'Tool: ' : '器具：')}}{{v.step.tool}}</view></block>
      <view wx:else class="muted">{{v.recorded ? (locale === 'en' ? 'Added to journal' : '已加入饮酒日记') : (locale === 'en' ? 'Log it in today’s diary, then add photos and thoughts.' : '完成后可一键记入今天的日记，再去补上照片和感想。')}}</view>
    </view>
    <view wx:if="{{!complete}}" class="guide-next small muted">{{(locale === 'en' ? 'Next · ' : '接下来 · ')}}{{v.nextLabel}}</view>
    <view class="guide-options">
      <button class="guide-disclosure" data-panel="settings" bindtap="togglePanel" aria-expanded="{{panel === 'settings'}}"><text>{{(locale === 'en' ? 'Playback settings' : '跟做设置')}}</text><text>{{v.panel === 'settings' ? '−' : '＋'}}</text></button>
      <view wx:if="{{panel === 'settings'}}" class="guide-option-body">
        <view class="row setting-row"><text>{{(locale === 'en' ? 'Step interval' : '每步等待')}}</text><picker range="{{v.delays}}" value="{{delayIndex}}" bindchange="delay" disabled="{{complete}}"><view class="chip">{{v.delay}}{{(locale === 'en' ? ' s ▾' : ' 秒 ▾')}}</view></picker></view>
        <view class="row setting-row"><text>{{(locale === 'en' ? 'Voice guidance' : '语音提示')}}</text><switch checked="{{speech}}" bindchange="voice" color="#92b58b" /></view>
        <view class="row setting-row"><text>{{(locale === 'en' ? 'Keep screen awake' : '保持屏幕常亮')}}</text><switch checked="{{awake}}" bindchange="awake" color="#92b58b" /></view>
        <bar-music locale="{{locale}}" />
        <view class="small muted">{{(locale === 'en' ? 'Pauses in the background. Tap Continue when you return. Shaking and stirring retain the recipe duration.' : '切到后台会暂停，返回后点继续。摇匀与搅拌会保留配方要求的时长。')}}</view>
      </view>
      <button class="guide-disclosure" data-panel="appearance" bindtap="togglePanel" aria-expanded="{{panel === 'appearance'}}"><view class="grow"><view>{{(locale === 'en' ? 'Glass and appearance' : '酒杯与外观')}}</view><view class="small muted">{{v.glasses[v.glassIndex]}}</view></view><view class="appearance-swatch" style="background:{{color}}" /><text>{{v.panel === 'appearance' ? '−' : '＋'}}</text></button>
      <view wx:if="{{panel === 'appearance'}}" class="guide-option-body">
        <view class="small muted">{{(locale === 'en' ? 'Final glass' : '最终杯型')}}</view>
        <scroll-view scroll-x class="shape-choices"><view wx:for="{{v.glassChoices}}" wx:key="key" class="shape-choice {{glassIndex === item._raw.index ? 'selected' : ''}}" data-index="{{item._raw.index}}" bindtap="glass" role="button" aria-label="{{item.name}}"><view class="shape-art"><bar-art look="{{item._raw.look}}" /></view><text>{{item.name}}</text></view></scroll-view>
        <view class="wrap"><text class="chip {{lookMode === 'recipe' ? 'selected' : ''}}" data-mode="recipe" bindtap="look">{{(locale === 'en' ? 'Recipe appearance' : '配方外观')}}</text><text class="chip {{lookMode === 'plain' ? 'selected' : ''}}" data-mode="plain" bindtap="look">{{(locale === 'en' ? 'Plain color' : '纯色')}}</text></view>
        <view class="label">{{(locale === 'en' ? 'Drink color' : '酒液颜色')}}</view><view class="wrap color-options"><button wx:for="{{v.colors}}" wx:key="*this" class="color-choice {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="color" aria-label="{{item}}">{{v.color === item ? '✓' : ''}}</button></view><input value="{{color}}" maxlength="7" bindchange="color" placeholder="#da9561" aria-label="{{(locale === 'en' ? 'Drink color' : '酒液颜色')}}" /><button class="secondary section" bindtap="closeAppearance">{{(locale === 'en' ? 'Done · collapse' : '完成并收起')}}</button>
      </view>
      <button class="guide-disclosure" data-panel="steps" bindtap="togglePanel" aria-expanded="{{panel === 'steps'}}"><text>{{(locale === 'en' ? 'All steps · ' : '全部步骤 · ')}}{{v.total}}</text><text>{{v.panel === 'steps' ? '−' : '＋'}}</text></button>
      <view wx:if="{{panel === 'steps'}}" class="guide-option-body"><view class="small muted">{{(locale === 'en' ? 'Jumping pauses playback. Continue when you are ready.' : '点选步骤后暂停，确认准备好再继续。')}}</view><view wx:for="{{v.stepList}}" wx:for-index="stepNumber" wx:key="index" class="step-choice {{index === item._raw.index ? 'active' : ''}}" data-index="{{item._raw.index}}" bindtap="jump" role="button"><view>{{item.index + 1}} · {{item.label}}</view><view class="small muted">{{item.hint}}</view></view></view>
    </view>
    <view class="guide-dock">
      <view wx:if="{{!complete}}" id="tour-play" class="guide-controls"><button class="secondary" disabled="{{index === 0}}" bindtap="previous">{{(locale === 'en' ? 'Back' : '上一步')}}</button><button class="guide-play" bindtap="toggle">{{v.playing ? (locale === 'en' ? 'Pause' : '暂停') : v.started ? (locale === 'en' ? 'Continue' : '继续') : (locale === 'en' ? 'Start mixing' : '开始跟做')}}</button><button class="secondary" bindtap="next">{{index === v.total - 1 ? (locale === 'en' ? 'Finish' : '完成') : (locale === 'en' ? 'Next' : '下一步')}}</button></view>
      <view wx:else class="guide-finish-controls"><button class="secondary" bindtap="toggle">{{(locale === 'en' ? 'Mix another' : '再调一杯')}}</button><button wx:if="{{recorded}}" bindtap="journal">{{(locale === 'en' ? 'View diary / add photos' : '查看日记 / 补充照片')}}</button><button wx:else bindtap="record">{{(locale === 'en' ? 'Add to journal' : '一键加入饮酒日记')}}</button></view>
    </view>
  </block>
  <view wx:else class="empty">{{(locale === 'en' ? 'Recipe not found. Go back and try again.' : '没有找到配方，请返回重试。')}}</view>
<bar-tour page="guide" /></view>
