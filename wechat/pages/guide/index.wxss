.guide-stage{height:400rpx;background:linear-gradient(145deg,#ddd9be,#aebfa2);border-radius:30rpx;text-align:center;position:relative;overflow:hidden}.guide-stage image{height:330rpx;width:300rpx;transform-origin:center 60%}.stage-caption{position:absolute;bottom:20rpx;left:0;right:0;color:#31523c;font-size:26rpx;font-weight:600}.amount{font-size:34rpx;color:#d9be88}.playing.action-shake image{animation:shake .7s infinite}.playing.action-stir image{animation:stir 1.5s infinite}.playing.action-pour image,.playing.action-serve image{animation:pour 2s infinite}@keyframes shake{0%,100%{transform:rotate(-8deg) translateX(-5rpx)}50%{transform:rotate(8deg) translateX(5rpx)}}@keyframes stir{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}@keyframes pour{0%,100%{transform:translateY(0)}50%{transform:translateY(-12rpx)}}
