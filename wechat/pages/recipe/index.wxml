<view class="page {{theme}}"><block wx:if="{{recipe}}"><view class="recipe-hero"><bar-art wx:if="{{recipe.isUserCreated}}" recipe="{{recipe}}" /><image wx:else src="{{image}}" mode="aspectFit" /><text class="recipe-mark">THE NEXT SIP</text></view><view class="row section"><view class="grow"><text class="eyebrow">{{v.recipe.englishName}}</text><view class="title">{{v.recipe.chineseName}}</view></view><button class="secondary" bindtap="favorite">{{v.favorite ? (locale === 'en' ? '♥ Saved' : '♥ 已收藏') : (locale === 'en' ? '♡ Favorite' : '♡ 收藏')}}</button></view><view class="wrap"><text class="chip">{{v.recipe.glass}}</text><text class="chip">{{v.profile.family}}</text><text wx:if="{{score !== null}}" class="chip">{{(locale === 'en' ? 'Taste match ' : '口味匹配 ')}}{{v.score}}</text></view>
  <view class="actions"><button bindtap="guide">{{(locale === 'en' ? 'Start mixing →' : '开始跟做 →')}}</button><button class="secondary" bindtap="log">{{(locale === 'en' ? 'Log this drink' : '记下这一杯')}}</button></view>
  <view id="tour-ingredients" class="panel section"><view class="section-title">{{(locale === 'en' ? 'Prepare ingredients' : '准备材料')}}</view><view wx:for="{{v.ingredients}}" wx:key="index" class="ingredient row"><text class="grow">{{item.raw}}</text><text class="small {{item._raw.available ? 'stock' : 'missing'}}">{{item.optional ? (locale === 'en' ? 'Optional' : '可选') : item.available ? (locale === 'en' ? '✓ Available' : '✓ 已有') : (locale === 'en' ? 'Needed' : '需准备')}}</text></view><view class="small muted section">{{(locale === 'en' ? 'Matched against My bar. Prepare ice and garnishes separately.' : '材料按「我的酒」匹配；另备做法中需要的冰块与装饰。')}}</view></view>
  <view class="panel"><view class="section-title">{{(locale === 'en' ? 'Method' : '调制方法')}}</view><view>{{v.recipe.method}}</view><view wx:if="{{recipe.note}}" class="info">{{v.recipe.note}}</view><button wx:if="{{recipe.source.url}}" class="link" bindtap="source">{{(locale === 'en' ? 'Copy recipe source ↗' : '复制原配方来源 ↗')}}</button></view>
  <view class="panel"><view class="section-title">{{(locale === 'en' ? 'Flavor profile' : '这一杯的风味')}}</view><view wx:if="{{profile.unknown.length}}" class="info">{{(locale === 'en' ? 'Some ingredients have no flavor data. Scores are unavailable.' : '部分材料尚无风味数据，不显示估计分数。')}}</view><block wx:else><view wx:for="{{v.bars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item._raw.value}}%" /></view><text class="bar-value">{{item.value}}</text></view><view class="muted section">{{v.explanation}}</view><view class="small muted">{{(locale === 'en' ? 'Editorial estimate, not measured flavor or ABV.' : '编辑估计，非实测口感或酒精度。')}}</view></block>
    <view wx:if="{{dna.ready && !profile.unknown.length}}" class="section"><view class="section-title">{{(locale === 'en' ? 'Your DNA vs this drink' : '个人口味与本杯对比')}}</view><view class="small muted">{{(locale === 'en' ? 'This drink / Your taste' : '本杯 / 你的偏好')}}</view><view wx:for="{{v.personalBars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="grow"><view class="bar-track"><view class="bar-fill" style="width:{{item._raw.first}}%" /></view><view class="bar-track" style="margin-top:8rpx"><view class="bar-fill" style="width:{{item._raw.second}}%;background:#92b58b" /></view></view><text class="small">{{item.first}} / {{item.second}}</text></view></view><picker range="{{v.compareOptions}}" bindchange="compare"><view class="picker section">{{(locale === 'en' ? 'Choose another drink to compare ▾' : '选择另一杯，比较风味 ▾')}}</view></picker><view wx:if="{{compare}}" class="section"><view class="small muted">{{(locale === 'en' ? 'Gold: this drink · Green: ' : '金色：本杯 · 绿色：')}}{{v.compare.name}}</view><view wx:if="{{compare.unknown || profile.unknown.length}}" class="info">{{(locale === 'en' ? 'Unknown ingredients prevent comparison.' : '包含未知材料，暂不比较。')}}</view><block wx:else><view wx:for="{{v.compare.bars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="grow"><view class="bar-track"><view class="bar-fill" style="width:{{item._raw.first}}%" /></view><view class="bar-track" style="margin-top:8rpx"><view class="bar-fill" style="width:{{item._raw.second}}%;background:#92b58b" /></view></view><text class="small">{{item.first}} / {{item.second}}</text></view></block></view>
  </view>
  <view class="panel"><view class="section-title">{{(locale === 'en' ? 'How did it taste?' : '喝过之后，感觉如何？')}}</view><view class="wrap"><text wx:for="{{v.ratings}}" wx:key="key" class="chip {{rating === item._raw.key ? 'selected' : ''}}" data-key="{{item._raw.key}}" bindtap="rate">{{item.name}}</text></view><view wx:if="{{rating}}" class="section"><view class="small muted" style="margin-bottom:16rpx">{{(locale === 'en' ? 'A little more detail (optional)' : '再具体一点（可选）')}}</view><view class="wrap"><text wx:for="{{v.feedbackOptions}}" wx:key="key" class="chip {{item._raw.selected ? 'selected' : ''}}" data-key="{{item._raw.key}}" bindtap="feedback">{{item.name}}</text></view><view wx:if="{{ratingDirty}}" class="actions"><button class="secondary" bindtap="cancelRating">{{(locale === 'en' ? 'Cancel' : '取消')}}</button><button bindtap="saveRating">{{(locale === 'en' ? 'Save rating' : '保存口味评价')}}</button></view><button wx:if="{{savedRating}}" class="link" bindtap="removeRating">{{(locale === 'en' ? 'Undo rating' : '撤销评价')}}</button></view></view>
  <button id="tour-share" class="section" bindtap="shareCard">{{(locale === 'en' ? 'Recipe image card' : '图片分享卡片')}}</button><view class="spacer" /><button wx:if="{{!recipe.isUserCreated}}" open-type="share" class="secondary">{{(locale === 'en' ? 'Share this recipe' : '分享这款配方给朋友')}}</button><button wx:else class="secondary" bindtap="edit">{{(locale === 'en' ? 'Edit my recipe' : '编辑我的配方')}}</button>
</block><view wx:else class="empty">{{(locale === 'en' ? 'Recipe not found. Return to Discover.' : '没有找到这款配方，请返回发现页。')}}</view><bar-tour page="recipe" /></view>
