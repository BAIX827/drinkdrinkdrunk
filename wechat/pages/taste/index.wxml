<view class="page {{theme}}"><text class="eyebrow">DISCOVER YOUR COCKTAIL DNA</text><view class="title">{{(locale === 'en' ? 'Discover your flavor signature.' : '你的口味，有迹可循。')}}</view><view class="subtitle">{{(locale === 'en' ? 'Choose your favorite flavors to build your profile.' : '选几种喜欢的味道，调出你的风味坐标。')}}</view>
  <view class="panel section"><view class="section-title">{{(locale === 'en' ? 'Which flavors do you enjoy?' : '喜欢什么味道？')}}</view><view class="palette"><view wx:for="{{v.palette}}" wx:key="key" class="flavor {{item._raw.selected ? 'selected' : ''}}" data-key="{{item._raw.key}}" bindtap="toggle"><view class="flavor-dot" style="background:{{item._raw.color}}">{{item.selected ? '✓' : ''}}</view><text>{{item.name}}</text></view></view><view class="label">{{(locale === 'en' ? 'Preferred strength' : '喜欢的酒感')}}</view><view class="wrap"><text wx:for="{{v.strengths}}" wx:key="key" class="chip {{strength === item._raw.key ? 'selected' : ''}}" data-key="{{item._raw.key}}" bindtap="strength">{{item.name}}</text></view><button class="section" bindtap="save">{{(locale === 'en' ? 'Save preferences, find your next sip' : '保存偏好，发现下一杯')}}</button></view>
  <view class="panel"><view class="section-title">{{(locale === 'en' ? 'Live flavor preview' : '实时口味预览')}}</view><view style="height:240rpx"><bar-art look="{{previewLook}}" /></view><view wx:for="{{v.previewBars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item._raw.value}}%" /></view><text class="bar-value">{{item.value}}</text></view></view><view wx:if="{{dna.ready}}" class="panel"><view class="row"><view class="section-title">{{v.dna.stage}}</view><text class="badge">{{v.dna.count}}{{(locale === 'en' ? ' rated drinks' : ' 款真实评价')}}</text></view><view class="muted">{{v.dna.description}}</view><view class="section"><view wx:for="{{v.bars}}" wx:key="name" class="bar-row"><text class="bar-label">{{item.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item._raw.value}}%" /></view><text class="bar-value">{{item.value}}</text></view></view><view class="info">{{v.dna.evidence}}</view></view>
  <view wx:for="{{v.recommendations}}" wx:key="title" class="section"><view class="section-title">{{item.title}}</view><view class="muted" style="margin-bottom:20rpx">{{item.subtitle}}</view><view wx:for="{{item.items}}" wx:for-item="drink" wx:key="id" class="panel row" data-id="{{drink._raw.id}}" bindtap="open"><image class="recommend-art" src="{{drink._raw.image}}" mode="aspectFit" /><view class="grow"><view class="card-name">{{drink.name}}</view><view class="badge">{{(locale === 'en' ? 'Match ' : '匹配 ')}}{{drink.score}} · {{drink.base}}</view><view class="small muted">{{drink.reason}}</view></view><text>↗</text></view></view>
  <view class="info">{{(locale === 'en' ? 'Flavor profiles are editorial estimates, not measurements or ABV. Match scores guide exploration, not the probability of liking a drink. Rate drinks to refine your DNA.' : '风味来自材料与用量的编辑估计，不是实测口感或酒精度。匹配分用于探索，不代表喜欢的概率；在配方页评价喝过的酒，可以逐渐完善 DNA。')}}</view>
</view>
