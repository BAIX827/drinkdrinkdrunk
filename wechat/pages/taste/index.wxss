.palette{display:grid;grid-template-columns:repeat(3,1fr);gap:18rpx}.flavor{text-align:center;padding:20rpx 8rpx;border:1rpx solid var(--line);border-radius:20rpx;color:var(--muted);font-size:25rpx}.flavor.selected{border-color:#e8c68d;color:inherit;background:rgba(180,165,100,.1)}.flavor-dot{width:52rpx;height:52rpx;margin:0 auto 12rpx;border-radius:50%;color:#fff;line-height:52rpx;font-weight:700}.recommend-art{width:115rpx;height:140rpx;background:#d6dec4;border-radius:18rpx;flex-shrink:0}
.flavor-icon{position:relative;width:80rpx;height:80rpx;margin:0 auto 8rpx}.flavor-icon image{width:100%;height:100%}.flavor-tick{position:absolute;right:-8rpx;bottom:0;width:30rpx;height:30rpx;line-height:30rpx;font-size:21rpx;border-radius:50%;background:#e8c68d;color:#193d32}.flavor-note{font-size:20rpx;color:var(--muted);margin-top:5rpx}.saved-flavors{margin-top:22rpx}.flavor-strip{white-space:nowrap;margin-top:10rpx}.saved-flavor{display:inline-flex;align-items:center;gap:8rpx;margin-right:12rpx;padding:6rpx 16rpx 6rpx 6rpx;border:1rpx solid var(--line);border-radius:24rpx;font-size:24rpx}.saved-flavor image{width:48rpx;height:48rpx}
