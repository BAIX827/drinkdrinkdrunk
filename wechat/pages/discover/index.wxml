<view class="page {{theme}}"><view wx:if="{{opening && !reduced}}" class="opening"><text>AFTER HOURS</text></view>
  <view class="row"><text class="eyebrow">DRINK DRINK DRUNK</text><button class="link" bindtap="settings">{{(locale === 'en' ? 'Settings ↗' : '设置 ↗')}}</button></view>
  <bar-music locale="{{locale}}" /><view class="title">{{(locale === 'en' ? 'Mix something you love tonight.' : '今晚，调点喜欢的。')}}</view>
  <view class="subtitle">{{v.total}}{{(locale === 'en' ? '  recipes · Your little home bar' : ' 款配方 · 你的私人小吧台')}}</view>
  <view class="hero section" bindtap="taste"><text class="eyebrow">DISCOVER YOUR COCKTAIL DNA</text><view class="section-title" style="margin-top:12rpx">{{v.ready ? (locale === 'en' ? 'A next sip that knows you better.' : '让下一杯，更懂你的口味。') : (locale === 'en' ? 'Find your taste, one lemon at a time.' : '从一片柠檬，认识你的口味。')}}</view><view class="row"><text class="muted">{{(locale === 'en' ? 'Pick flavors. Find your next drink.' : '选择风味，找到属于你的那一杯')}}</text><text>↗</text></view></view>
  <input placeholder="{{(locale === 'en' ? 'Search drinks, spirits or ingredients' : '搜索酒名、基酒或材料')}}" value="{{query}}" bindinput="search" confirm-type="search" aria-label="{{(locale === 'en' ? 'Search recipes' : '搜索配方')}}" />
  <scroll-view scroll-x class="chips"><text class="chip {{scope === 'all' ? 'selected' : ''}}" data-value="all" bindtap="scope">{{(locale === 'en' ? 'All recipes' : '全部配方')}}</text><text class="chip {{scope === 'favorites' ? 'selected' : ''}}" data-value="favorites" bindtap="scope">{{(locale === 'en' ? 'Favorites' : '我的收藏')}}</text><text class="chip {{scope === 'curated' ? 'selected' : ''}}" data-value="curated" bindtap="scope">{{(locale === 'en' ? 'Curated recipes' : '精选配方')}}</text><text class="chip {{scope === 'mine' ? 'selected' : ''}}" data-value="mine" bindtap="scope">{{(locale === 'en' ? 'My recipes' : '我的配方')}}</text></scroll-view>
  <scroll-view scroll-x class="chips"><text class="chip {{stock === 'all' ? 'selected' : ''}}" data-value="all" bindtap="stock">{{(locale === 'en' ? 'Any ingredients' : '不限材料')}}</text><text class="chip {{stock === '0' ? 'selected' : ''}}" data-value="0" bindtap="stock">{{(locale === 'en' ? 'Ready to mix' : '现在能调')}}</text><text class="chip {{stock === '1' ? 'selected' : ''}}" data-value="1" bindtap="stock">{{(locale === 'en' ? 'Missing up to 1' : '最多缺 1 样')}}</text><text class="chip {{stock === '2' ? 'selected' : ''}}" data-value="2" bindtap="stock">{{(locale === 'en' ? 'Missing up to 2' : '最多缺 2 样')}}</text></scroll-view>
  <view class="label">{{(locale === 'en' ? 'Check these categories' : '检查哪些材料')}}</view><view class="wrap"><text wx:for="{{v.categories}}" wx:key="key" class="chip {{item._raw.selected ? 'selected' : ''}}" data-key="{{item._raw.key}}" bindtap="category">{{item.name}}</text></view><view class="small muted" style="margin:14rpx 0">{{(locale === 'en' ? 'Unchecked categories do not mean you own those ingredients.' : '未检查的类别不代表已有材料。')}}</view><view class="row" style="margin-bottom:24rpx"><picker range="{{v.bases}}" bindchange="base"><view class="chip">{{v.base}} ▾</view></picker><button wx:if="{{ready}}" class="link" bindtap="sort">{{v.sort === 'match' ? (locale === 'en' ? 'Taste match ↓' : '按口味匹配 ↓') : (locale === 'en' ? 'Default order ↓' : '默认顺序 ↓')}}</button><text class="muted small">{{v.cards.length}}{{(locale === 'en' ? '  recipes' : ' 款')}}</text></view>
  <view wx:if="{{stock !== 'all' && !inventoryCount}}" class="info">{{(locale === 'en' ? 'Add your ingredients in My bar to see what you can mix.' : '先在「我的酒」勾选已有材料，就能知道现在可以调什么。')}}</view>
  <view class="grid"><view wx:for="{{v.cards}}" wx:key="id" class="drink-card" data-id="{{item._raw.id}}" bindtap="open"><view class="drink-art"><bar-art wx:if="{{item._raw.custom}}" recipe="{{item._raw.recipe}}" /><image wx:else src="{{item._raw.image}}" mode="aspectFit" lazy-load /><text wx:if="{{item._raw.favorite}}" class="heart">♥</text></view><view class="card-body"><view class="card-name">{{item.name}}</view><view class="card-en">{{item.english}}</view><view class="badge">{{item.base}}<text wx:if="{{item._raw.score !== null}}">{{(locale === 'en' ? ' · Match ' : ' · 匹配 ')}}{{item.score}}</text></view><view class="stock {{item._raw.missing ? 'missing' : ''}}">{{!item.checked ? (locale === 'en' ? 'No categories checked' : '尚未检查材料') : item.missing ? (locale === 'en' ? 'Missing ' : '还缺 ') + item.missing + (locale === 'en' ? ' ingredients' : ' 样材料') : (locale === 'en' ? 'Ready to mix' : '材料齐了 · 可以开调')}}</view></view></view></view>
  <view wx:if="{{!cards.length}}" class="empty">{{(locale === 'en' ? 'No recipes found. Try another search or filter.' : '没有找到配方，试试其他关键词或筛选条件。')}}</view>
  <button class="secondary section" bindtap="create">{{(locale === 'en' ? '＋ Write your own recipe' : '＋ 记下自己的配方')}}</button>
  <view class="footer-note">{{(locale === 'en' ? 'Your next inspiration starts here.' : '一杯的灵感，从这里开始。')}}</view>
</view>
