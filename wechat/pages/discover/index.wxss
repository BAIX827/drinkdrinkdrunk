.opening{position:fixed;inset:0;z-index:1000;pointer-events:none;display:flex;align-items:center;justify-content:center;color:#e8c68d;animation:welcome 1.2s both}.opening::before,.opening::after{content:"";position:absolute;top:0;bottom:0;width:50%;background:#12382c;z-index:-1}.opening::before{left:0;animation:left-curtain 1.2s both}.opening::after{right:0;animation:right-curtain 1.2s both}.opening text{letter-spacing:6rpx;font-size:30rpx}@keyframes left-curtain{0%,30%{transform:translateX(0)}100%{transform:translateX(-100%)}}@keyframes right-curtain{0%,30%{transform:translateX(0)}100%{transform:translateX(100%)}}@keyframes welcome{0%,25%{opacity:1}100%{opacity:0}}@media(prefers-reduced-motion:reduce){.opening{display:none}}
