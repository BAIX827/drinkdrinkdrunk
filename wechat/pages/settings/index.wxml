<view class="page {{theme}}"><text class="eyebrow">MAKE YOURSELF AT HOME</text><view class="title">{{(locale === 'en' ? 'Settings & data' : '设置与数据')}}</view><view class="subtitle">{{(locale === 'en' ? 'Your bar and memories are stored on this device.' : '你的酒架和回忆，只保存在这台设备。')}}</view>
  <view wx:if="{{blocked}}" class="info">{{(locale === 'en' ? 'Local data could not be read. Saving is paused. Export the original files before restoring a valid backup.' : '本地数据读取失败，已停止保存。请先导出原始文件留存，再导入有效备份恢复。')}}<button class="secondary section" bindtap="raw">{{(locale === 'en' ? 'Export original data files' : '导出原始数据文件')}}</button></view>
  <view class="panel section"><view class="section-title">{{(locale === 'en' ? 'Language' : '语言 / Language')}}</view><view class="wrap"><text class="chip {{locale === 'zh-CN' ? 'selected' : ''}}" data-locale="zh-CN" bindtap="language">{{(locale === 'en' ? '简体中文' : '简体中文')}}</text><text class="chip {{locale === 'en' ? 'selected' : ''}}" data-locale="en" bindtap="language">English</text></view><view class="row section"><text>{{(locale === 'en' ? 'Reduce motion' : '减少动态效果')}}</text><switch checked="{{reduced}}" bindchange="motion" color="#92b58b" /></view><button class="secondary section" bindtap="intro">{{(locale === 'en' ? 'Replay introduction' : '重看新手引导')}}</button><bar-music locale="{{locale}}" /></view><view class="panel section"><view class="section-title">{{(locale === 'en' ? 'Appearance' : '吧台外观')}}</view><view class="wrap"><text wx:for="{{v.themes}}" wx:key="key" class="chip {{theme === item._raw.key ? 'selected' : ''}}" data-key="{{item._raw.key}}" bindtap="theme">{{item.name}}</text></view></view>
  <view class="panel"><view class="section-title">{{(locale === 'en' ? 'Local data' : '本地数据')}}</view><view class="row"><text class="muted">{{(locale === 'en' ? 'Stock / Saved / Custom / Diary' : '库存 / 收藏 / 自建 / 日记')}}</text><text>{{v.inventory}} / {{v.favorites}} / {{v.custom}} / {{v.logs}}</text></view><view class="small muted section">{{(locale === 'en' ? 'About  ' : '当前约 ')}}{{v.size}}{{(locale === 'en' ? ' KB · 3.8 MB data limit' : ' KB · 数据上限 3.8 MB')}}</view><view class="actions"><button bindtap="export">{{(locale === 'en' ? 'Export JSON file' : '导出 JSON 文件')}}</button><button class="secondary" bindtap="copy">{{(locale === 'en' ? 'Copy backup text' : '复制备份文本')}}</button></view><view class="info">{{(locale === 'en' ? 'Uninstalling WeChat, clearing app data or changing devices can remove local records. Back up regularly. Backups include photos and diary entries; keep them somewhere you trust.' : '卸载微信、清理小程序数据或更换手机可能丢失本地记录。建议定期导出备份。导出文件包含日记与照片，请保存在你信任的位置。')}}</view></view>
  <view class="panel"><view class="section-title">{{(locale === 'en' ? 'Restore / import from the web app' : '恢复 / 从网页版迁移')}}</view><view class="muted">{{(locale === 'en' ? 'Import JSON backups from the web, iOS or Mac shared bar. Backups are validated before you confirm replacement.' : '支持当前网页版、iOS / Mac 共用吧台导出的 JSON 备份。先验证内容，确认后再替换。')}}</view><view class="actions"><button class="secondary" bindtap="chooseFile">{{(locale === 'en' ? 'Choose file from chat' : '选择聊天中的文件')}}</button><button class="secondary" bindtap="paste">{{(locale === 'en' ? 'Read clipboard' : '读取剪贴板')}}</button></view><view class="label">{{(locale === 'en' ? 'Or paste JSON below' : '或直接粘贴 JSON 文本')}}</view><textarea value="{{backupText}}" bindinput="input" maxlength="-1" placeholder="{{(locale === 'en' ? 'Paste your backup' : '粘贴备份内容')}}" /><button class="section" bindtap="importText">{{(locale === 'en' ? 'Check and import backup' : '检查并导入备份')}}</button></view>
  <view class="panel"><view class="section-title">{{(locale === 'en' ? 'drinkdrinkdrunk · WeChat Mini Program' : '大喝特喝 · 微信小程序版')}}</view><view class="muted">{{(locale === 'en' ? '145 recipes · Ingredient matching · Cocktail DNA · Guided mixing · Photo diary' : '145 款内置配方 · 本地材料匹配 · Cocktail DNA · 分步跟做 · 照片日记')}}</view><view class="small muted section">{{(locale === 'en' ? 'Chinese and English, local music and built-in recipe narration, hand-drawn bottles, ten glasses, animated steps, image sharing and local backups. Arbitrary custom-text narration requires authorizing the WeChat translation plugin for your AppID.' : '中英文界面、离线音乐与内置配方语音、手绘瓶子、十种杯型、完整步骤动效、图片分享和本地备份。任意自建文本朗读需在小程序账号中授权微信同声传译插件。')}}</view></view>
</view>
