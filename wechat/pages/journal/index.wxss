.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:6rpx;margin-top:20rpx;text-align:center}.weekday{color:var(--muted);font-size:23rpx;padding:10rpx 0}.day{height:80rpx;border-radius:16rpx;font-size:26rpx;padding-top:7rpx}.day.today{border:1rpx solid #c4b677}.day.selected{background:#e8c68d;color:#183c30}.dot{height:20rpx;line-height:20rpx;font-size:18rpx;color:#91b878}.selected .dot{color:#315b3a}.journal-art{width:100rpx;height:120rpx;background:#d6dec4;border-radius:18rpx;flex-shrink:0}.log-note{white-space:pre-wrap;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
