<view class="page {{theme}}"><text class="eyebrow">LITTLE MOMENTS, GOOD SIPS</text><view class="title">{{(locale === 'en' ? 'Drink journal' : '饮酒日记')}}</view><view class="subtitle">{{(locale === 'en' ? 'Remember the flavor and how you felt.' : '记下味道，也记下当时的心情。')}}</view>
  <view class="panel section"><view class="calendar-heading"><button class="link month-arrow" disabled="{{!previous}}" data-direction="previous" bindtap="month" aria-label="{{(locale === 'en' ? 'Previous month' : '上个月')}}">‹</button><view class="calendar-month">{{v.month}}</view><button class="link month-arrow" disabled="{{!next}}" data-direction="next" bindtap="month" aria-label="{{(locale === 'en' ? 'Next month' : '下个月')}}">›</button></view><view class="calendar"><text wx:for="{{v.weekdays}}" wx:key="*this" class="weekday">{{item}}</text><view wx:for="{{v.cells}}" wx:key="key" class="day {{item._raw.selected ? 'selected' : ''}} {{item._raw.today ? 'today' : ''}}" data-date="{{item._raw.date}}" bindtap="day"><text>{{item.day}}</text><view wx:if="{{item._raw.count}}" class="dot">{{item.count > 1 ? item.count : '•'}}</view></view></view><view class="row section"><text class="small muted">{{(locale === 'en' ? 'This month:  ' : '本月留下 ')}}{{v.count}}{{(locale === 'en' ? ' memories' : ' 杯回忆')}}</text><button class="link" bindtap="today">{{(locale === 'en' ? 'Today' : '回到今天')}}</button></view></view>
  <view class="row section journal-date-row"><view class="section-title">{{v.selected}}</view><button class="link" bindtap="add">{{(locale === 'en' ? '＋ Log a drink' : '＋ 记一杯')}}</button></view>
  <view wx:for="{{v.logs}}" wx:key="id" class="panel row" data-id="{{item._raw.id}}" bindtap="edit"><view class="journal-art"><bar-art recipe="{{item._raw.recipe}}" look="{{item._raw.look}}" /></view><view class="grow"><view class="card-name">{{item.name}}</view><view class="log-note muted">{{item.note || (locale === 'en' ? 'No thoughts added yet.' : '这一杯，还没有留下感想。')}}</view><view wx:if="{{item._raw.photoCount}}" class="badge">{{item.photoCount}}{{(locale === 'en' ? '  photos' : ' 张照片')}}</view><button wx:if="{{item._raw.recipeID}}" class="link" data-recipe="{{item._raw.recipeID}}" catchtap="rate">{{(locale === 'en' ? 'Rate the linked recipe' : '打开关联配方评价')}}</button></view><text>↗</text></view>
  <view wx:if="{{!logs.length}}" class="empty"><view>{{(locale === 'en' ? 'A blank page, ready for a memory.' : '这一天，还是一张空白酒单。')}}</view><button class="secondary section" bindtap="add">{{(locale === 'en' ? 'Log this drink' : '记下这一杯')}}</button></view>
</view>
