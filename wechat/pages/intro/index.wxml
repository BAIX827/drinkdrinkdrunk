<view class="page {{theme}}"><view class="row"><text class="eyebrow">WELCOME TO YOUR HOME BAR</text><button class="link" bindtap="finish">{{(locale === 'en' ? 'Skip introduction' : '跳过引导')}}</button></view><view class="hero section"><view style="height:260rpx"><bar-art /></view><view class="badge">{{v.destination}} · {{index+1}} / {{v.total}}</view><view class="title">{{v.title}}</view><view>{{v.description}}</view><progress class="section" percent="{{(index+1)/total*100}}" activeColor="#d9be88" stroke-width="3" /><view class="actions"><button disabled="{{!index}}" class="secondary" bindtap="previous">{{(locale === 'en' ? 'Previous' : '上一项')}}</button><button bindtap="next">{{index === v.total-1 ? (locale === 'en' ? 'Start exploring' : '开始体验') : (locale === 'en' ? 'Next' : '下一项')}}</button></view></view></view>
