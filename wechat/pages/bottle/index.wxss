.bottle-preview{height:210rpx;background:#d6dec4;border-radius:24rpx}.bottle-panel{padding:20rpx 22rpx;border-top:1rpx solid var(--line)}.bottle-page .appearance-editor{margin-top:20rpx}.type-art{width:100rpx;height:110rpx;display:block;margin:auto}.type-check{display:block;height:26rpx;line-height:26rpx}.type-choices .shape-choice{height:215rpx;overflow:hidden}.type-choices .shape-choice>view{height:55rpx;line-height:27rpx;overflow-wrap:anywhere}.bottle-color{width:54rpx;height:54rpx;line-height:50rpx;text-align:center;border-radius:50%;border:2rpx solid #eee;color:#fff;text-shadow:0 1rpx 4rpx #000}.bottle-color.selected{outline:3rpx solid #e8c68d;outline-offset:3rpx}.bottle-drawing{width:100%;height:500rpx;background:#fff8e8;border-radius:20rpx}
