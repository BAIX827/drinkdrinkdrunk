<view class="page bottle-page {{theme}}">
  <text class="eyebrow">MAKE IT YOURS</text><view class="title">{{v.editing ? (locale === 'en' ? 'Edit bottle' : '编辑瓶子') : (locale === 'en' ? 'Add a bottle' : '登记材料')}}</view>
  <view class="bottle-preview"><bar-art mode="bottle" item="{{bottle}}" /></view>
  <view class="label">{{(locale === 'en' ? 'Custom name' : '自定义名称')}}</view><input value="{{name}}" bindinput="name" maxlength="100" />
  <view class="appearance-editor section">
    <view class="appearance-summary" data-panel="type" bindtap="togglePanel" role="button" aria-expanded="{{panel === 'type'}}"><view class="grow"><view>{{(locale === 'en' ? 'Standard ingredient' : '标准材料类型')}}</view><view class="small muted">{{v.types[v.typeIndex]}}</view></view><text class="small muted">{{v.panel === 'type' ? (locale === 'en' ? 'Collapse' : '收起') : (locale === 'en' ? 'Tap to choose' : '点击选择')}}</text></view>
    <view wx:if="{{panel === 'type'}}" class="bottle-panel">
      <input value="{{query}}" bindinput="search" placeholder="{{(locale === 'en' ? 'Search ingredients' : '搜索材料名称')}}" aria-label="{{(locale === 'en' ? 'Search ingredients' : '搜索材料名称')}}" />
      <scroll-view scroll-x class="chips"><text class="chip {{category === 'all' ? 'selected' : ''}}" data-key="all" bindtap="category">{{(locale === 'en' ? 'All' : '全部')}}</text><text wx:for="{{v.categories}}" wx:key="key" class="chip {{category === item._raw.key ? 'selected' : ''}}" data-key="{{item._raw.key}}" bindtap="category">{{item.name}}</text></scroll-view>
      <scroll-view scroll-x class="shape-choices type-choices" scroll-into-view="type-{{typeIndex}}"><view wx:for="{{v.typeChoices}}" wx:key="key" id="type-{{item._raw.index}}" class="shape-choice {{typeIndex === item._raw.index ? 'selected' : ''}}" data-index="{{item._raw.index}}" bindtap="type" role="button" aria-label="{{item.name}}"><image class="type-art" src="{{item._raw.image}}" mode="aspectFit" lazy-load /><view>{{item.name}}</view><text class="type-check">{{v.typeIndex === item.index ? '✓' : ''}}</text></view></scroll-view>
      <view wx:if="{{!typeChoices.length}}" class="small muted">{{(locale === 'en' ? 'No ingredients found. Try a shorter name.' : '未找到材料，试试更短的名称。')}}</view><button class="link" data-index="0" bindtap="type">{{(locale === 'en' ? 'Choose a type later' : '暂不选择类型')}}</button>
    </view>
  </view>
  <view class="appearance-editor section">
    <view class="appearance-summary" data-panel="appearance" bindtap="togglePanel" role="button" aria-expanded="{{panel === 'appearance'}}"><view class="grow"><view>{{(locale === 'en' ? 'Bottle and color' : '瓶型与颜色')}}</view><view class="small muted">{{v.shapes[v.shapeIndex]}}</view></view><view class="appearance-swatch" style="background:{{color}}" /><text class="small muted">{{v.panel === 'appearance' ? (locale === 'en' ? 'Collapse' : '收起') : (locale === 'en' ? 'Tap to edit' : '点击修改')}}</text></view>
    <view wx:if="{{panel === 'appearance'}}" class="bottle-panel">
      <scroll-view scroll-x class="shape-choices" scroll-into-view="shape-{{shapeIndex}}"><view wx:for="{{v.shapeChoices}}" wx:key="key" id="shape-{{item._raw.index}}" class="shape-choice {{shapeIndex === item._raw.index ? 'selected' : ''}}" data-index="{{item._raw.index}}" bindtap="shape" role="button" aria-label="{{item.name}}"><view class="shape-art"><bar-art mode="bottle" item="{{item._raw.bottle}}" /></view><text>{{item.name}}</text></view></scroll-view>
      <view class="label">{{(locale === 'en' ? 'Color' : '颜色')}}</view><view class="wrap"><view wx:for="{{v.colors}}" wx:key="*this" class="bottle-color {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="color" role="button" aria-label="{{item}}">{{v.color === item ? '✓' : ''}}</view></view><input class="section" value="{{color}}" bindchange="color" maxlength="7" placeholder="#79a883" aria-label="{{(locale === 'en' ? 'Color' : '颜色')}}" /><button class="secondary section" bindtap="closePanel">{{(locale === 'en' ? 'Done · collapse' : '完成并收起')}}</button>
    </view>
  </view>
  <view class="appearance-editor section">
    <view class="appearance-summary" data-panel="drawing" bindtap="togglePanel" role="button" aria-expanded="{{panel === 'drawing'}}"><view class="grow">{{(locale === 'en' ? 'Draw on the label' : '标签手绘')}}</view><text class="small muted">{{v.panel === 'drawing' ? (locale === 'en' ? 'Collapse' : '收起') : (locale === 'en' ? 'Tap to edit' : '点击修改')}}</text></view>
    <view wx:if="{{panel === 'drawing'}}" class="bottle-panel"><canvas type="2d" id="drawing" class="bottle-drawing" disable-scroll catchtouchstart="start" catchtouchmove="move" catchtouchend="end" catchtouchcancel="end" /><view class="actions"><button class="secondary" bindtap="undo">{{(locale === 'en' ? 'Undo stroke' : '撤销一笔')}}</button><button class="secondary" bindtap="clear">{{(locale === 'en' ? 'Clear drawing' : '清空手绘')}}</button></view><button class="secondary section" bindtap="closePanel">{{(locale === 'en' ? 'Done · collapse' : '完成并收起')}}</button></view>
  </view>
  <button class="section" bindtap="save">{{(locale === 'en' ? 'Save ingredient' : '保存材料')}}</button><button wx:if="{{editing}}" class="link danger section" bindtap="remove">{{(locale === 'en' ? 'Delete' : '删除')}}</button>
</view>
