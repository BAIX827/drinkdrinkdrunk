<view class="page {{theme}}"><text class="eyebrow">YOUR HOME BAR</text><view class="title">{{(locale === 'en' ? 'My home bar' : '我的酒架')}}</view><view class="subtitle">{{(locale === 'en' ? 'Choose the spirits and ingredients you have at home.' : '勾选手边已有的酒和材料，剩下的交给灵感。')}}</view>
  <view class="hero section row"><view><view class="stat">{{v.count}} <text class="small">{{(locale === 'en' ? 'ingredients' : '样材料')}}</text></view><view class="muted">{{(locale === 'en' ? 'On your shelf' : '已经在你的酒架上')}}</view></view><view bindtap="discover"><view class="stat">{{v.ready}} <text class="small">{{(locale === 'en' ? ' recipes ↗' : '款配方 ↗')}}</text></view><view class="muted">{{(locale === 'en' ? 'Ready to mix' : '现在就可以调制')}}</view></view></view>
  <view class="row section"><view class="section-title">{{(locale === 'en' ? 'My home bar' : '我的酒架')}}</view><button id="tour-add-item" class="link" bindtap="edit">{{(locale === 'en' ? '＋ Add ingredient' : '＋ 登记材料')}}</button></view><view class="shelf"><view wx:for="{{v.bottles}}" wx:key="id" class="shelf-bottle" data-id="{{item._raw.id}}" bindtap="edit"><view style="height:210rpx"><bar-art mode="bottle" item="{{item}}" /></view><view class="small">{{item.name}}</view><view class="badge">{{(locale === 'en' ? 'Edit bottle ↗' : '编辑瓶子 ↗')}}</view></view></view><input placeholder="{{(locale === 'en' ? 'Find an ingredient' : '寻找一种材料')}}" value="{{query}}" bindinput="search" />
  <scroll-view scroll-x class="chips"><text class="chip {{category === 'all' ? 'selected' : ''}}" data-value="all" bindtap="category">{{(locale === 'en' ? 'All' : '全部')}}</text><text wx:for="{{v.categories}}" wx:key="key" class="chip {{category === item._raw.key ? 'selected' : ''}}" data-value="{{item._raw.key}}" bindtap="category">{{item.name}}</text></scroll-view>
  <view class="grid"><view wx:for="{{v.items}}" wx:key="name" class="stock-tile {{item._raw.owned ? 'owned' : ''}}" data-type="{{item._raw.name}}" bindtap="toggle" role="checkbox" aria-checked="{{item._raw.owned}}"><view class="row"><text>{{item.name}}</text><text class="check">{{item.owned ? '✓' : '＋'}}</text></view><text class="small muted">{{item.owned ? (locale === 'en' ? 'On your shelf' : '已在酒架') : (locale === 'en' ? 'Tap to add' : '点选加入')}}</text></view></view>
  <view wx:if="{{!items.length}}" class="empty">{{(locale === 'en' ? 'No ingredients found. Try a shorter name.' : '未找到材料，试试更短的名称。')}}</view>
  <view wx:if="{{unknown.length}}" class="section"><view class="section-title">{{(locale === 'en' ? 'Other imported ingredients' : '备份中的其他材料')}}</view><view wx:for="{{v.unknown}}" wx:key="id" class="panel row"><text>{{item.name}}</text><button class="link" data-id="{{item._raw.id}}" bindtap="removeUnknown">{{(locale === 'en' ? 'Remove' : '移除')}}</button></view></view>
  <view class="info">{{(locale === 'en' ? 'Inventory tracks availability, not quantities. Optional ingredients are excluded. Prepare ice and garnishes mentioned in the method separately.' : '库存记录“有没有”，不扣减用量。可选材料不计入缺料；做法中提到的冰块、装饰需要另外准备。')}}</view>
<bar-tour page="inventory" /></view>
