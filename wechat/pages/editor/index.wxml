<view class="page {{theme}}"><canvas type="2d" id="photo-canvas" style="position:fixed;left:-3000px;top:0;width:300px;height:300px;pointer-events:none" /><text class="eyebrow">{{v.type === 'recipe' ? 'YOUR OWN CREATION' : 'SAVE THIS MOMENT'}}</text><view class="title">{{v.type === 'recipe' ? (locale === 'en' ? 'Turn inspiration into a recipe.' : '把灵感，写成配方。') : (locale === 'en' ? 'How was this drink?' : '这一杯，什么滋味？')}}</view>
  <block wx:if="{{type === 'log'}}"><view class="label">{{(locale === 'en' ? 'Date' : '日期')}}</view><picker mode="date" value="{{date}}" bindchange="date"><view class="picker">{{v.date}} ▾</view></picker><view class="label">{{(locale === 'en' ? 'Choose a recipe (optional)' : '从配方选择（可选）')}}</view><picker range="{{v.recipeNames}}" value="{{recipeIndex}}" bindchange="selectRecipe"><view class="picker">{{v.recipeNames[v.recipeIndex]}} ▾</view></picker></block>
  <view class="appearance-editor section">
    <view class="appearance-summary" bindtap="toggleAppearance" role="button" aria-expanded="{{appearanceOpen}}"><view class="grow"><view>{{(locale === 'en' ? 'Glass and color' : '杯型与颜色')}}</view><view class="small muted">{{v.glassNames[v.glassIndex]}}</view></view><view class="appearance-swatch" style="background:{{look.color}}" /><text class="small muted">{{v.appearanceOpen ? (locale === 'en' ? 'Collapse' : '收起') : (locale === 'en' ? 'Tap to edit' : '点击修改')}}</text></view>
    <view wx:if="{{appearanceOpen}}" class="appearance-body">
<view class="appearance-preview"><bar-art look="{{look}}" /></view><view class="label">{{(locale === 'en' ? 'Glass' : '杯型')}}</view><scroll-view scroll-x class="shape-choices"><view wx:for="{{v.glassChoices}}" wx:key="key" class="shape-choice {{glassIndex === item._raw.index ? 'selected' : ''}}" data-index="{{item._raw.index}}" bindtap="glass" role="button" aria-label="{{item.name}}"><view class="shape-art"><bar-art look="{{item._raw.look}}" /></view><text>{{item.name}}</text></view></scroll-view><view class="label">{{(locale === 'en' ? 'Drink color' : '酒液颜色')}}</view><input value="{{color}}" maxlength="7" bindinput="color" /><view wx:if="{{type === 'log'}}" class="wrap section"><text class="chip {{lookMode === 'keep' ? 'selected' : ''}}" data-mode="keep" bindtap="appearance">{{(locale === 'en' ? 'Current look' : '当前外观')}}</text><text class="chip {{lookMode === 'plain' ? 'selected' : ''}}" data-mode="plain" bindtap="appearance">{{(locale === 'en' ? 'Plain color' : '纯色')}}</text></view>
      <button class="secondary section" bindtap="closeAppearance">{{(locale === 'en' ? 'Done · collapse' : '完成并收起')}}</button>
    </view>
  </view>
  <view class="label">{{v.type === 'recipe' ? (locale === 'en' ? 'Recipe name' : '配方名称') : (locale === 'en' ? 'Drink name' : '这一杯的名字')}}</view><input value="{{name}}" data-field="name" bindinput="input" maxlength="100" placeholder="{{(locale === 'en' ? 'For example: Friday Mojito' : '例如：周五的莫吉托')}}" />
  <block wx:if="{{type === 'recipe'}}"><view class="label">{{(locale === 'en' ? 'English name (optional)' : '英文名称（可选）')}}</view><input value="{{english}}" data-field="english" bindinput="input" maxlength="100" placeholder="Friday Mojito" /><view class="label">{{(locale === 'en' ? 'Ingredients and quantities · one per line' : '材料与用量 · 每行一种')}}</view><textarea value="{{ingredients}}" data-field="ingredients" bindinput="input" maxlength="5000" placeholder="{{(locale === 'en' ? 'White rum 45 ml&#10;Lime juice 20 ml&#10;Simple syrup 15 ml' : '白朗姆 45 ml&#10;青柠汁 20 ml&#10;糖浆 15 ml')}}" /><view class="label">{{(locale === 'en' ? 'Method' : '调制方法')}}</view><textarea value="{{method}}" data-field="method" bindinput="input" maxlength="5000" placeholder="{{(locale === 'en' ? 'Write the full method. Guided mode uses preparation steps and your original method.' : '写下完整做法。自建配方将按备料和原方提示跟做。')}}" /></block>
  <view class="label">{{v.type === 'recipe' ? (locale === 'en' ? 'Recipe notes (optional)' : '配方备注（可选）') : (locale === 'en' ? 'Taste, mood or company (optional)' : '味道、心情，或一起喝的人（可选）')}}</view><textarea value="{{note}}" data-field="note" bindinput="input" maxlength="5000" placeholder="{{(locale === 'en' ? 'Leave a few words for your future self.' : '留一点文字给以后的自己。')}}" />
  <block wx:if="{{type === 'log'}}"><view class="label">{{(locale === 'en' ? 'Photos · up to 3' : '照片 · 最多 3 张')}}</view><view class="photo-row"><view wx:for="{{photos}}" wx:key="index"><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto" /><button class="photo-remove" data-index="{{index}}" bindtap="removePhoto">{{(locale === 'en' ? 'Remove' : '移除')}}</button></view></view><button wx:if="{{photos.length < 3}}" class="secondary section" loading="{{busy}}" disabled="{{busy}}" bindtap="addPhotos">{{(locale === 'en' ? '＋ Add photos' : '＋ 添加照片')}}</button><view class="small muted section">{{(locale === 'en' ? 'Photos are compressed locally and included in JSON backups. Keep original files separately.' : '照片压缩后保存在本机，并随 JSON 备份导出。请另行保留原图。')}}</view></block>
  <view class="actions section"><button class="secondary" bindtap="cancel">{{(locale === 'en' ? 'Cancel' : '取消')}}</button><button disabled="{{busy}}" bindtap="save">{{v.type === 'recipe' ? (locale === 'en' ? 'Save recipe' : '保存配方') : (locale === 'en' ? 'Save entry' : '保存日记')}}</button></view><button wx:if="{{editing}}" class="link danger section" bindtap="remove">{{(locale === 'en' ? 'Delete ' : '删除这')}}{{v.type === 'recipe' ? (locale === 'en' ? ' recipes' : '款配方') : (locale === 'en' ? 'diary entry' : '篇日记')}}</button>
</view>
