<view class="page {{theme}}"><text class="eyebrow">A RECIPE TO KEEP</text><view class="title">{{(locale === 'en' ? 'Recipe image card' : '图片分享卡片')}}</view><scroll-view scroll-x class="chips"><text wx:for="{{v.templates}}" wx:key="id" class="chip {{selected === item._raw.id ? 'selected' : ''}}" data-id="{{item._raw.id}}" bindtap="template">{{item.name}}</text></scroll-view><view wx:if="{{busy}}" class="empty">{{(locale === 'en' ? 'Loading…' : '加载中…')}}</view><image wx:if="{{preview}}" src="{{preview}}" mode="widthFix" style="width:100%;border-radius:20rpx" bindtap="preview" /><view class="actions"><button disabled="{{busy || !preview}}" bindtap="save">{{(locale === 'en' ? 'Save to photos' : '保存到相册')}}</button><button disabled="{{busy || !preview}}" class="secondary" bindtap="share">{{(locale === 'en' ? 'Share image' : '分享图片')}}</button></view><button wx:if="{{!busy && !preview}}" bindtap="render">{{(locale === 'en' ? 'Retry' : '重试')}}</button><canvas type="2d" id="share-canvas" style="position:fixed;left:-3000px;top:0;width:1080px;height:1080px" /></view>
