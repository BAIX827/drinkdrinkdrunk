page{background:#122f2a;color:#f7efd9;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}button{font-size:27rpx;line-height:1.5;margin:0;padding:20rpx 26rpx;border-radius:18rpx;background:#e8c68d;color:#183c30;font-weight:600}button::after{border:0}button[disabled]{opacity:.42}input,textarea{width:100%;background:rgba(128,150,130,.12);color:inherit;border:1rpx solid rgba(167,187,158,.25);border-radius:18rpx;padding:20rpx;font-size:28rpx}input{height:88rpx}textarea{min-height:180rpx;line-height:1.6}.page{min-height:100vh;padding:34rpx 30rpx 64rpx;background:#122f2a;color:#f7efd9;--muted:#b0c2b2;--panel:#1c3c32;--line:rgba(177,194,168,.22)}.page.light{background:#f5efdf;color:#193d32;--muted:#637266;--panel:#fffaf0;--line:#d9dfce}.page.dark{background:#0c201c;--panel:#173129}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#c9b680;font-weight:600}.title{font-size:52rpx;line-height:1.25;font-weight:700;margin:12rpx 0 22rpx;letter-spacing:1rpx}.subtitle,.muted{color:var(--muted);font-size:25rpx}.small{font-size:23rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.wrap{display:flex;flex-wrap:wrap;gap:14rpx}.grow{flex:1;min-width:0}.section{margin-top:34rpx}.section-title{font-size:32rpx;font-weight:650;margin-bottom:20rpx}.panel{padding:28rpx;border-radius:24rpx;background:var(--panel);border:1rpx solid var(--line);margin-bottom:22rpx}.secondary{background:rgba(139,169,143,.12);border:1rpx solid var(--line);color:inherit}.link{background:transparent;color:#d9be88;padding:10rpx;font-size:25rpx}.light .link{color:#4f6d38}.danger{color:#eda291}.light .danger{color:#a44835}.chip{padding:12rpx 23rpx;border-radius:30rpx;background:rgba(139,169,143,.1);border:1rpx solid var(--line);font-size:24rpx;color:var(--muted)}.chip.selected{background:#e8c68d;color:#193d32;border-color:#e8c68d}.chips{white-space:nowrap;margin:22rpx 0}.chips .chip{display:inline-block;margin-right:12rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.drink-card{border:1rpx solid var(--line);border-radius:25rpx;overflow:hidden;background:var(--panel)}.drink-art{height:230rpx;background:linear-gradient(160deg,#e5dfc9,#c0cbb1);display:flex;align-items:center;justify-content:center;position:relative}.drink-art image{height:215rpx;width:190rpx}.card-body{padding:20rpx}.card-name{font-size:29rpx;font-weight:650}.card-en{font-size:20rpx;min-height:32rpx;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.badge{font-size:20rpx;color:#d9be88}.light .badge{color:#527445}.stock{font-size:22rpx;margin-top:12rpx;color:#abd0a5}.missing{color:#edb58e}.light .stock{color:#427043}.light .missing{color:#96562b}.heart{position:absolute;right:20rpx;top:12rpx;color:#71582c;font-size:30rpx}.empty{text-align:center;padding:64rpx 24rpx;color:var(--muted)}.divider{border-bottom:1rpx solid var(--line);margin:24rpx 0}.label{display:block;font-size:25rpx;color:var(--muted);margin:24rpx 0 12rpx}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1}.hero{padding:32rpx;border-radius:28rpx;border:1rpx solid var(--line);background:linear-gradient(135deg,rgba(150,171,115,.14),rgba(187,139,72,.05));margin-bottom:26rpx}.hero .title{font-size:48rpx}.stat{font-size:42rpx;color:#e8c68d;font-weight:650}.light .stat{color:#547344}.bar-row{display:flex;gap:18rpx;align-items:center;margin:15rpx 0;font-size:24rpx}.bar-label{width:65rpx}.bar-track{height:12rpx;border-radius:12rpx;background:rgba(159,179,150,.18);flex:1;overflow:hidden}.bar-fill{height:100%;border-radius:12rpx;background:#d9be88}.bar-value{width:44rpx;text-align:right;color:var(--muted)}.info{padding:22rpx 26rpx;border-left:4rpx solid #c6b476;background:rgba(162,170,113,.1);font-size:24rpx;color:var(--muted);margin:24rpx 0}.picker{padding:22rpx;border:1rpx solid var(--line);border-radius:18rpx;background:rgba(139,169,143,.1)}.photo-row{display:flex;gap:14rpx;flex-wrap:wrap}.photo-row image{width:170rpx;height:170rpx;border-radius:16rpx}.photo-remove{font-size:22rpx;padding:8rpx;background:transparent;color:inherit}.footer-note{margin-top:42rpx;text-align:center;color:var(--muted);font-size:21rpx}.spacer{height:24rpx}
.shape-choices{white-space:nowrap;width:100%;margin:16rpx 0}.shape-choice{display:inline-block;vertical-align:top;width:150rpx;margin-right:12rpx;padding:12rpx 4rpx;border:2rpx solid var(--line);border-radius:18rpx;text-align:center;font-size:22rpx;white-space:normal}.shape-choice.selected{border-color:#e8c68d;background:rgba(180,165,100,.16)}.shape-art{height:110rpx}.appearance-preview{height:240rpx;margin-top:28rpx}.step-choice{padding:20rpx 0;border-bottom:1rpx solid var(--line)}.step-choice.active{border-left:4rpx solid #e8c68d;padding-left:16rpx}.drink-art .heart{background:#f5efdfcc;padding:8rpx 14rpx;line-height:1.3}.card-body .bar-row{margin:8rpx 0;font-size:20rpx}.card-body .bar-label{width:50rpx}
/* Native button defaults must not consume a whole row on phone screens. */
.row>button{width:auto;min-width:0;flex-shrink:0}.row>picker{min-width:0}.row>switch{flex-shrink:0}.row>.section-title{min-width:0}.actions button{width:0;min-width:0;flex:1;padding:20rpx 12rpx;overflow-wrap:anywhere}.title{font-size:44rpx;overflow-wrap:anywhere}.card-name,.log-note,.ingredient .grow{overflow-wrap:anywhere}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.picker{overflow-wrap:anywhere}.page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}
.appearance-editor{border:1rpx solid var(--line);border-radius:20rpx;background:var(--panel);overflow:hidden}.appearance-summary{display:flex;align-items:center;gap:16rpx;padding:18rpx 22rpx;font-size:26rpx;min-height:88rpx}.appearance-summary>.small{flex-shrink:0}.appearance-swatch{width:30rpx;height:30rpx;border-radius:50%;border:2rpx solid #ffffff66;flex-shrink:0}.appearance-body{padding:0 22rpx 24rpx;border-top:1rpx solid var(--line)}.appearance-body .appearance-preview{height:160rpx;margin-top:16rpx}
